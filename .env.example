# Application
APP_ENV=development
APP_NAME=sawakli-ai

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5433
POSTGRES_DB=sawakli
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Database URL
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5433/sawakli
# API
API_HOST=0.0.0.0
API_PORT=8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000


# JWT settings
JWT_SECRET=change-this-to-a-real-secret
JWT_EXPIRE_MINUTES=30

# Connector Layer — OAuth token encryption (CONN-02)
# 32-byte AES-256 key, base64-encoded. Generate a real one for local dev with:
#   python -c "from sawakli.connectors.oauth.crypto import generate_encryption_key as g; print(g())"
# Never commit a real key — this placeholder is invalid on purpose.
CONNECTOR_TOKEN_ENCRYPTION_KEY=REPLACE_ME_WITH_GENERATED_KEY

