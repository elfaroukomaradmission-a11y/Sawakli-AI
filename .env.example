# Application
APP_ENV=development
APP_NAME=sawakli-ai

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5433
POSTGRES_DB=sawakli
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Database URL
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5433/sawakli
# API
API_HOST=0.0.0.0
API_PORT=8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# JWT settings
JWT_SECRET=change-this-to-a-real-secret
JWT_EXPIRE_MINUTES=30